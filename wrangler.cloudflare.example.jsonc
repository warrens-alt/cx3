{
  // Explicit opt-in deployment configuration. Confirm the existing account/Worker before deploying.
  "name": "cx3",
  "main": "server/cloudflare/worker.ts",
  "compatibility_date": "2026-09-26",
  "keep_vars": true,
  "define": { "process.env.NODE_ENV": "\"production\"" },
  "build": { "command": "npm run build" },
  "assets": {
    // Only client assets. Never publish dist/server, repository files or uploaded reports.
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "r2_buckets": [
    { "binding": "CLI_REPORTS", "bucket_name": "cx3-cli-reports" }
    // Optional saved definitions: add a SAVED_ANALYSES binding to an approved private bucket.
    // See docs/SAVED-INVESTIGATIONS.md; this example does not provision or enable storage.
  ],
  "vars": {
    "CX_AUTH_MODE": "firebase",
    "CX_ALLOW_DEV_AUTH": "false",
    "ENABLE_CLI_SAMPLE_DATA": "false",
    "CX_CLI_STORAGE_PROVIDER": "r2",
    // Owner must check the bucket's public URL/domain settings before enabling uploads.
    "CX_CLI_R2_PRIVATE_CONFIRMED": "false"
    // Optional saved definitions also require CX_SAVED_ANALYSES_STORAGE_PROVIDER=r2
    // and CX_SAVED_ANALYSES_R2_PRIVATE_CONFIRMED=true after checking bucket privacy.
  }
}
