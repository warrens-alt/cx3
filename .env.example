PORT=3000
NODE_ENV=development
# Prefer Application Default Credentials; never commit a credential file.
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_MAX_BYTES_BILLED=1000000000
# Exact expected audience of signed IAP identity assertions.
# Production analytics fail closed when this is missing.
IAP_AUDIENCE=
# Explicit local-development bypass. Ignored in production.
CX_ALLOW_DEV_AUTH=false
# AI Studio Preview can authenticate its already signed-in Firebase user against
# the user's own Firestore access profile. This fallback is ignored in production.
CX_ALLOW_FIREBASE_PREVIEW_AUTH=true
DEV_USER_EMAIL=dev@example.invalid
CX_DEV_TENANTS=default_tenant
CX_DEV_ROLE=viewer
# Configure permitted real email addresses in the deployment, not in source control.
# Example shape: {"authorised@example.com":{"tenants":["default_tenant"],"role":"admin"}}
CX_ACCESS_POLICY_JSON={}
# Optional exact browser origins for state-changing API requests, comma separated.
# When empty, the request Origin must match the HTTP Host header.
CX_ALLOWED_ORIGINS=
# In-process analytical request ceilings. Production scale-out also needs an
# upstream shared quota/rate limit because these counters are per server process.
CX_MAX_CONCURRENT_QUERIES_PER_SUBJECT=4
CX_MAX_CONCURRENT_QUERIES_GLOBAL=40

# Versioned reporting reads only a separately controlled dataset of published snapshots.
# Format: project.cx_reporting. Empty means no approved reporting dataset is available.
CX_REPORTING_DATASET=
# Server-only signing secret, at least 32 random bytes; configure through deployment secret management.
CX_REPORT_SIGNING_KEY=


# Marketing API-table client mapping
# Map each CX3 tenant ID to the exact client_name values observed in the approved
# marketing API table. Do not use display-name guesses. Example only:
# CX_MARKETING_CLIENT_MAP_JSON={"mtn":["<approved client_name>"],"mondo":["<approved client_name>"]}
CX_MARKETING_CLIENT_MAP_JSON=

# Choose exactly one already allowlisted observed-spend field per tenant only when
# the live warehouse exposes one. The supplied 26 Sep 2026 marketing schema contains
# BUDGET but no observed-spend column, so leave this empty for the current schema.
# Never select budget/planned/estimated fields as spend.
# CX_MARKETING_SPEND_FIELD_JSON={"mtn":"spend"}
CX_MARKETING_SPEND_FIELD_JSON=

# Optional cross-source attribution contract. Only activate after the named fields
# are reconciled between the marketing API table and lead ledger.
# Example only:
# CX_MARKETING_ATTRIBUTION_JSON={"mtn":{"marketingSourceField":"<approved marketing field>","leadSourceField":"offershop_source"}}
CX_MARKETING_ATTRIBUTION_JSON=

# Synthetic CLI benchmark data is for development/testing only.
# Production rejects sample loading unless this is deliberately enabled.
ENABLE_CLI_SAMPLE_DATA=false
